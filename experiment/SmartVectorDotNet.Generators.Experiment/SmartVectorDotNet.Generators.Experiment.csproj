<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>14.0</LangVersion>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <InterceptorsNamespaces>$(InterceptorsNamespaces);SmartVectorDotNet.Interceptors</InterceptorsNamespaces>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/SmartVectorDotNet/SmartVectorDotNet.csproj" />
        <ProjectReference Include="../../src/SmartVectorDotNet.Generators/SmartVectorDotNet.Generators.csproj">
            <OutputItemType>Analyzer</OutputItemType>
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
        </ProjectReference>
    </ItemGroup>

</Project>
