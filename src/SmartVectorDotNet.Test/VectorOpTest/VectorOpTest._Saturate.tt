<#@ template debug="false" hostspecific="false" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ output extension=".g.cs" #>
<#
var types = new string[]{
    "byte", "sbyte", "short", "ushort", "int", "uint", "long", "ulong", "nuint", "nint",
};
#>
using System;
using System.Collections.Generic;
using System.Linq;
using System.Numerics;
using System.Text;
using System.Threading.Tasks;

namespace SmartVectorDotNet;

public partial class VectorOpTest
{
#if NET7_0_OR_GREATER
<#  foreach(var type in types) { #>

    public static TheoryData<<#=type#>, <#=type#>> SaturateTestCases_<#=type#>()
        => new (){
            { ScalarOp.MinValue<<#=type#>>(), ScalarOp.MinValue<<#=type#>>() },
            { ScalarOp.MinValue<<#=type#>>(), 0 },
            { ScalarOp.MinValue<<#=type#>>(), ScalarOp.MaxValue<<#=type#>>() },
            { 0, ScalarOp.MinValue<<#=type#>>() },
            { 0, 0 },
            { 0, ScalarOp.MaxValue<<#=type#>>() },
            { ScalarOp.MaxValue<<#=type#>>(), ScalarOp.MinValue<<#=type#>>() },
            { ScalarOp.MaxValue<<#=type#>>(), 0 },
            { ScalarOp.MaxValue<<#=type#>>(), ScalarOp.MaxValue<<#=type#>>() },
        };

    [Theory, MemberData(nameof(SaturateTestCases_<#=type#>))]
    public void AddSaturate_<#=type#>(<#=type#> a, <#=type#> b)
    {
        unchecked
        {
            var exp = ScalarOp.AddSaturate<<#=type#>>(a, b);
            var act = VectorOp.AddSaturate<<#=type#>>(new(a), new(b))[0];
            Assert.Equal(exp, act);
        }
    }

    [Theory, MemberData(nameof(SaturateTestCases_<#=type#>))]
    public void SubtractSaturate_<#=type#>(<#=type#> a, <#=type#> b)
    {
        var exp = ScalarOp.SubtractSaturate<<#=type#>>(a, b);
        var act = VectorOp.SubtractSaturate<<#=type#>>(new(a), new(b))[0];
        Assert.Equal(exp, act);
    }

<#  } #>
#endif
}
