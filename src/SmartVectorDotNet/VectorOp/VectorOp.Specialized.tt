<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ output extension=".g.cs" #>
<#
var VectorOpMatcher = new Regex(
    @"\[VectorOp(?:Attribute)?\]\s*" +
    @"(?<accessibility>public|internal|private)\s+static\s+partial\s+Vector\s*<\s*T\s*>\s+(?<method>\w+)\s*<\s*T\s*>\s*\((?<args>.+)\)\s*" + 
    @"where\s+T\s*:\s*unmanaged\s*;");

var methodDefinitions = new Dictionary<string, MethodDef[]>();
foreach(var VectorOpPath in Directory.GetFiles(Host.ResolvePath("."), "*.cs"))
{
    if(VectorOpPath.EndsWith(".g.cs"))
    {
        continue;
    }
    var VectorOpSource = File.ReadAllText(VectorOpPath);
    var matcheds = VectorOpMatcher.Matches(
        VectorOpSource);
    var methods = matcheds.Cast<Match>().Select(match => new MethodDef(match)).ToArray();
    methodDefinitions.Add(
        Path.GetFileName(VectorOpPath),
        methods);
}
#>
